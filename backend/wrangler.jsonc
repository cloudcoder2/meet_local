{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cholo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "dev",
    "CURRENCY": "BDT",
    "DEFAULT_CITY": "dhaka",
    "ADMIN_PHONES": "",
    "DRIVER_AUTO_APPROVE": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cholo-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "00000000000000000000000000000000" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "DISPATCH", "class_name": "DispatchHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DispatchHub"] }],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "cholo-media" }
  ]
}
